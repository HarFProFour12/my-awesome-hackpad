{
    "manufacturer": "Charalampos Fanouriakis",
    "keyboard_name": "Hackpad",
    "maintainer": "HarFProFour12",
    "processor": "RP2040",
    "bootloader": "rp2040",

    "diode_direction": "COL2ROW",

    "matrix_pins": {
        "cols": ["GP28", "GP29", "GP7", "GP3"],
        "rows": ["GP26", "GP27"]
    },

    "encoder": {
        "rotary": [
            {
                "pin_a": "GP0",
                "pin_b": "GP1"
            }
        ]
    },

    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true,
        "oled": true
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [1, 3], "x": 3, "y": 1}
            ]
        }
    },

    "url": "https://github.com/HarFProFour12/my_awesome_hackpad",

    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    }
}